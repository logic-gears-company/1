# AXIS — example environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AXIS

# Supabase Postgres (use the Transaction Pooler for DATABASE_URL and the direct
# connection for DIRECT_URL / Prisma migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TRUST_HOST=true

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email / transactional mail (optional)
RESEND_API_KEY=
EMAIL_FROM="axis.ia.oficial@gmail.com"

# AI — current default path is Groq; OpenRouter is optional.
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Semantic memory — Cohere embeddings are optional. AXIS degrades gracefully
# to deterministic memory ranking when the key is absent or quota is exhausted.
EMBEDDINGS_PROVIDER=cohere
COHERE_API_KEY=
EMBEDDINGS_MONTHLY_CALL_CAP=900

# Logging
LOG_LEVEL=info

# Optional legacy integrations from the boilerplate
REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
API_SECRET_KEY=
CORS_ORIGINS=http://localhost:3000
